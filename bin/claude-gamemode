#!/usr/bin/env bash
# Launched by the "Claude Code" shortcut in the Steam library.
# Opens a full-screen terminal (xterm) joined to the persistent Claude session.
# Closing it (or quitting the "game" from Steam) only detaches: Claude keeps running.
set -uo pipefail
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-deck/gamemode.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "--- $(date '+%F %T') start (DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-})"

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
. "$HOME/.local/lib/claude-deck/lib/common.sh"
# Steam may leave these set for games; they can break normal programs.
unset LD_PRELOAD LD_LIBRARY_PATH

# Look of the terminal; override in ~/.config/claude-deck/gamemode.conf
FONT="Hack"
FONT_SIZE=25
BG="#232627"
FG="#fcfcfc"
[[ -f "$HOME/.config/claude-deck/gamemode.conf" ]] && . "$HOME/.config/claude-deck/gamemode.conf"

claude-session --ensure

# Tells claude-notify that the terminal is on screen (no "finished" toasts needed).
RUN="${XDG_RUNTIME_DIR:-/tmp}/claude-deck"
mkdir -p "$RUN"
echo $$ >"$RUN/gamemode.pid"
trap 'rm -f "$RUN/gamemode.pid"' EXIT

# xterm: plain X11 window (runs natively under gamescope), no toolbars, truecolor.
cd "$PROJECT_DIR" 2>/dev/null || cd "$HOME"
xterm -fullscreen -title "Claude Code" -fa "$FONT" -fs "$FONT_SIZE" -bg "$BG" -fg "$FG" \
    -bc -bw 0 -b 12 \
    -xrm 'XTerm*utf8: 1' -xrm 'XTerm*termName: xterm-256color' -xrm 'XTerm*directColor: true' \
    -xrm 'XTerm*selectToClipboard: true' -xrm 'XTerm*saveLines: 0' \
    -e tmux -L claude attach -t claude
echo "--- $(date '+%F %T') exit $?"
