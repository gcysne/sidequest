#!/usr/bin/env bash
# Attach to the persistent Claude Code session, starting it if needed.
# The session runs in tmux under a user systemd service, so it survives switching between Desktop Mode and
# Game Mode, and every client (Desktop terminal, the Game Mode panel, Remote Control)
# sees the same conversation.
#   claude-session                attach (start with --continue if not running)
#   claude-session --new          start a fresh conversation if not running, then attach
#   claude-session --ensure       start if not running, don't attach (CLAUDE_SESSION_NEW=1: fresh conversation)
#   claude-session --restart-new  end the running session and start a fresh conversation (don't attach)
#   claude-session --status       print "running" or "stopped"
#   claude-session --stop         end the session
set -euo pipefail
T=(tmux -L claude)

running() { "${T[@]}" has-session -t claude 2>/dev/null; }

ensure() {
    if ! running; then
        systemctl --user set-environment CLAUDE_SESSION_NEW="${CLAUDE_SESSION_NEW:-0}"
        systemctl --user start claude-session.service
        systemctl --user unset-environment CLAUDE_SESSION_NEW
    fi
    # Size the window to whichever client was used last, and let touch/trackpad scrolling go through tmux.
    "${T[@]}" set -g window-size latest
    "${T[@]}" set -g mouse on
    local conf="$HOME/.local/lib/sidequest/tmux/touch-scroll.conf"
    [[ -f "$conf" ]] && "${T[@]}" source-file "$conf"
    return 0
}

case "${1:-}" in
    --stop)        systemctl --user stop claude-session.service; exit 0 ;;
    --status)      running && echo running || echo stopped; exit 0 ;;
    --new)         export CLAUDE_SESSION_NEW=1 ;;
    --ensure)      ensure; exit 0 ;;
    --restart-new) systemctl --user stop claude-session.service
                   CLAUDE_SESSION_NEW=1 ensure; exit 0 ;;
    "")            ;;
    *)             sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
ensure
exec "${T[@]}" attach -t claude
